# Local development defaults to the loopback interface. Set HOST=0.0.0.0 only behind a firewall/reverse proxy.
HOST=127.0.0.1
PORT=5173
# Set both before exposing your workspace over HTTPS. Generate a strong, unique password.
# AUTH_USER=clipforge
# AUTH_PASSWORD=
# DATA_DIR=.clipforge
# MAX_SOURCE_MINUTES=180
# MAX_SOURCE_MB=2048
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_CPU_THREADS=4
# WHISPER_CACHE=/path/to/models
# Optional: configure TikTok here instead of using the Integrations page.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://clips.example.com/api/tiktok/callback
