# ============================================================================
# Curiousity environment configuration — copy to .env and edit.
# Full reference: docs/ENVIRONMENT.md
# ============================================================================

# --- Required secrets (generate unique values!) -----------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Fernet key for encrypting credentials at rest. Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_TO_A_FERNET_KEY

# --- Administrator bootstrap (created automatically on first start) ---------
# The initial admin account. NEVER commit the real password.
ADMIN_EMAIL=evilcurious6@gmail.com
ADMIN_PASSWORD=SET_A_SECURE_PASSWORD_DURING_DEPLOYMENT

# --- Database ---------------------------------------------------------------
POSTGRES_USER=curiousity
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=curiousity

# --- Application ------------------------------------------------------------
APP_NAME=Curiousity
ENVIRONMENT=production
DEBUG=false
# Origins allowed by CORS (the browser-facing URL of the frontend)
CORS_ORIGINS=["http://localhost","http://localhost:3000"]
PUBLIC_API_URL=http://localhost/api
HTTP_PORT=80

# --- Security ---------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120

# --- AI provider defaults (bootstrap provider — configurable at runtime) ----
# Initial: local Ollama inside Docker (http://ollama:11434 on the compose network).
# Later: point to a remote AI VPS, e.g. https://ai.your-domain.com — see docs/MULTI_VPS.md
AI_BASE_URL=http://ollama:11434
AI_MODEL=curiousity-glm
AI_PROVIDER_TYPE=ollama
AGENT_MAX_STEPS=8
AGENT_CONTEXT_BUDGET_CHARS=24000

# --- Google OAuth (optional — enables Google Sign-In/Sign-Up) ---------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://<your-domain>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# --- SMTP (optional — password-reset emails; otherwise token shown in UI) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=curiousity@your-domain.com
SMTP_TLS=true

# --- Registration controls --------------------------------------------------
REGISTRATION_ENABLED=true
MAINTENANCE_MODE=false

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=25

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Docker build/runtime ---------------------------------------------------
BACKEND_URL=http://backend:8000
UVICORN_WORKERS=2
