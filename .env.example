# HTTP is for localhost only. Keep this listener private behind an HTTPS proxy.
HOST=127.0.0.1
PORT=5173
# Enable only when exactly one trusted proxy is in front of the app, with the
# backend port firewalled. PUBLIC_ORIGIN is the canonical HTTPS site origin.
# TRUST_PROXY=1
# PUBLIC_ORIGIN=https://clips.example.com
# Optional compose.https.yaml overlay: set a DNS name (no https:// or port).
# CURIOUSITY_DOMAIN=clips.example.com

# Provision the administrator BEFORE opening registration (see README).
# Set ADMIN_EMAIL to the intended admin email, then run npm run admin in a
# terminal for a hidden password prompt. Never put the password here.
# ADMIN_EMAIL=
# ALLOW_SIGNUP=false
# PREMIUM_DAILY_JOBS=10

# Keep the existing .clipforge directory on upgrade, including its .key.
# DATA_DIR=.clipforge
# MAX_SOURCE_MINUTES=180
# MAX_SOURCE_MB=2048
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_CPU_THREADS=4
# WHISPER_CACHE=/path/to/models

# Optional OAuth application credentials for the administrator's account ONLY.
# Members configure their own connections in Settings. Buffer keys are per-user.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://clips.example.com/api/tiktok/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback
