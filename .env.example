# HTTP is for localhost only. Keep this listener private behind an HTTPS proxy.
HOST=127.0.0.1
PORT=5173
# For Nginx/Caddy on this Linux host, proxy to 127.0.0.1 and trust loopback only.
# TRUST_PROXY=loopback
# Only for a private backend reached via one trusted non-loopback proxy:
# TRUST_PROXY=1
# PUBLIC_ORIGIN=https://clips.example.com
# Optional compose.https.yaml overlay: set a DNS name (no https:// or port).
# CURIOUSITY_DOMAIN=clips.example.com

# Provision the administrator BEFORE opening registration (see README).
# Set ADMIN_EMAIL to the intended admin email, then run npm run admin in a
# terminal for a hidden password prompt. Never put the password here.
# ADMIN_EMAIL=
# ALLOW_SIGNUP=false

# Keep the existing .clipforge directory on upgrade, including its .key.
# DATA_DIR=.clipforge
# YouTube and picture + audio source limits (not applied to raw device video):
# MAX_SOURCE_MINUTES=180
# MAX_SOURCE_MB=2048
# Wait for a finished replay (checks do not hold the media worker):
# REPLAY_WAIT_MINUTES=360
# REPLAY_CHECK_SECONDS=60
# Timeout per Captions processing stage; not an upload size limit:
# CAPTION_TASK_MINUTES=240
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_CPU_THREADS=4
# WHISPER_CACHE=/path/to/models

# Configure n8n in Settings → Admin. No n8n environment keys are required.
# Configure Google/TikTok apps in Admin, or keep these server-managed app credentials.
# Members authorize their own accounts. Legacy API flag affects only MCP/Buffer setup.
# ENABLE_LEGACY_INTEGRATION_API=false
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://clips.example.com/api/tiktok/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback

# Chat → Reach. Server-only, shared search quotas; optional.
# Without an Exa key these use the hosted Exa MCP free rate limit.
# DISCOVERY_ENABLED=true
# EXA_API_KEY=
# YOUTUBE_DATA_API_KEY=
